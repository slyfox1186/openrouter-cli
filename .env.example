# openrouter-cli configuration. Copy to .env (mode 600) and fill in the key.
# The CLI reads only this project's .env; exported shell variables do not override it.

# Required. Create a key at https://openrouter.ai/settings/keys; give it its own spend limit.
OPENROUTER_API_KEY=

# API root. Change only for OpenRouter regional domains.
OPENROUTER_CLI_BASE_URL=https://openrouter.ai/api/v1

# App attribution headers. An empty referer sends no HTTP-Referer header.
OPENROUTER_CLI_APP_REFERER=
OPENROUTER_CLI_APP_TITLE=openrouter-cli
OPENROUTER_CLI_APP_CATEGORIES=cli-agent

# Ceiling for --max-cost on any single command, in US dollars.
OPENROUTER_CLI_HARD_CAP_USD=5.00

# Reasoning effort when --effort is not given; clamped to what each model supports.
OPENROUTER_CLI_DEFAULT_EFFORT=high

# Output token budget (reasoning plus answer); clamped to each model's limit.
# 64000 stays under Gemini 4's 65,536 single-request limit.
OPENROUTER_CLI_MAX_OUTPUT_TOKENS=64000

# Private routing: refuse providers that store or train on prompts, and require
# zero data retention unless --allow-retention is passed.
OPENROUTER_CLI_DATA_COLLECTION=deny
OPENROUTER_CLI_ZDR=true

# Hours before the cached model catalog is refreshed.
OPENROUTER_CLI_CATALOG_TTL_HOURS=24

# Abort when no bytes arrive for this long, and cap the whole call.
OPENROUTER_CLI_IDLE_TIMEOUT_SECONDS=300
OPENROUTER_CLI_TOTAL_TIMEOUT_SECONDS=3600

# Per-file and total limits for files attached with -f.
OPENROUTER_CLI_MAX_FILE_BYTES=1048576
OPENROUTER_CLI_MAX_INPUT_BYTES=4194304
