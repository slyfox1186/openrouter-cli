# Optional settings: copy without overwriting to $XDG_CONFIG_HOME/openrouter-cli/config.env
# (default $HOME/.config/openrouter-cli/config.env), mode 600. With OPENROUTER_CLI_HOME,
# the legacy path is ROOT/.env. Individual exported setting names do not override this file.
# API keys never belong here: use `openrouter-cli login` or `openrouter-cli auth set`.
# Credentials are encrypted in the resolved state directory's credentials/ subdirectory.

# API root. Change only for OpenRouter regional domains.
OPENROUTER_CLI_BASE_URL=https://openrouter.ai/api/v1

# App attribution headers. An empty referer sends no HTTP-Referer header.
OPENROUTER_CLI_APP_REFERER=
OPENROUTER_CLI_APP_TITLE=openrouter-cli
OPENROUTER_CLI_APP_CATEGORIES=cli-agent

# Reasoning effort when --effort is not given; clamped to what each model supports.
OPENROUTER_CLI_DEFAULT_EFFORT=high

# Output token budget (reasoning plus answer); clamped to each model's limit.
OPENROUTER_CLI_MAX_OUTPUT_TOKENS=64000

# Private routing: "zdr" sends data_collection=deny plus zdr=true (Safety Retention
# endpoints follow your OpenRouter privacy settings); "no-training" sends only
# data_collection=deny, for models that have no ZDR endpoint.
OPENROUTER_CLI_PRIVACY=zdr

# Hours before the cached model catalog is refreshed.
OPENROUTER_CLI_CATALOG_TTL_HOURS=24

# Abort when no bytes are sent or received for this long (keepalives count), and cap the
# whole call.
OPENROUTER_CLI_IDLE_TIMEOUT_SECONDS=300
OPENROUTER_CLI_TOTAL_TIMEOUT_SECONDS=3600

# Per-file and total limits for files and text sent with a request.
OPENROUTER_CLI_MAX_FILE_BYTES=1048576
OPENROUTER_CLI_MAX_INPUT_BYTES=4194304
